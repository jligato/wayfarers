+
+## Adds the element MATRIX under the existing Beasts view: the player's forged
+## elements, their counter relationships, and the five element routes
+## (/elements/state, /elements/forge, /elements/upgrade, /elements/resonance,
+## /elements/inheritance).
+##
+## A SECTION of the Beasts tab, not a new tab, for the reason the companion
+## above is one: an element ladder the player has to go hunting for is an
+## element ladder nobody reads, and _layout_hub() sizes the nav grid from
+## buttons.size().
+##
+## Instantiated from the .tscn rather than .new()-ed from the script, so the
+## scene root the panel builds itself into actually exists.
+func _mount_element_matrix(view: Control) -> void:
+	if view == null or not is_instance_valid(view):
+		return
+	if view.get_node_or_null("VBox") == null:
+		push_error("MainHub: Beasts view has no VBox for the element matrix panel")
+		return
+	if view.find_child("ElementMatrixView", true, false) != null:
+		return
+	var scene: PackedScene = load(ELEMENT_MATRIX_VIEW)
+	if scene == null:
+		push_error("MainHub could not load the element matrix scene")
+		return
+	var panel: Node = scene.instantiate()
+	panel.name = "ElementMatrixView"
+	# Added BEFORE it is bound: a node made with instantiate() and never added
+	# never enters the tree, never gets _ready, and so never builds its UI.
+	view.get_node("VBox").add_child(panel)
+	# The player id is a plain property, NOT a setup() call: the panel defers
+	# exactly one refresh from _ready, so setup() would schedule a second
+	# request that supersedes the first and renders nothing.
+	panel.set("player_id", str(GameState.player_data.get("id", "")))
+	# Repeated here as well as inside the panel's own _build_ui, so a later edit
+	# to the panel cannot silently leave this one greyed out as a prototype.
+	_mark_live_buttons(panel, "element_matrix_action")
 ## Adds the CRAFTING section under the existing Equipment view.
